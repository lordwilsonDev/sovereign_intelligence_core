{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MSB v2: Launch server",
      "type": "python",
      "request": "launch",
      "module": "msb_v2",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "/Users/lordwilson/msb-v2",
        "MSB_HOST": "127.0.0.1",
        "MSB_PORT": "8766",
        "MSB_REASONING_SCORER": "1"
      }
    },
    {
      "name": "MSB v2: Attach",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 8766
      },
      "pathMappings": [
        {
          "localRoot": "/Users/lordwilson/msb-v2",
          "remoteRoot": "/Users/lordwilson/msb-v2"
        }
      ]
    }
  ]
}
