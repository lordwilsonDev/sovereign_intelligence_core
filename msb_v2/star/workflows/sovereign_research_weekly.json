{
  "id": "sovereign-research-weekly",
  "name": "Weekly Hypothesis Generation & Inversion",
  "harness_action": {
    "type": "http",
    "method": "POST",
    "url": "http://127.0.0.1:8766/research/assistant/run",
    "body": {
      "phase": "hypothesis_generation"
    }
  },
  "retry_policy": {
    "max_retries": 1,
    "backoff_factor": 120
  },
  "failure_policy": {
    "on_failure": "alert",
    "alert_template": "research_assistant_failure"
  },
  "active": true,
  "depends_on": [
    "sovereign-research-daily"
  ],
  "cron": "0 9 * * 1"
}