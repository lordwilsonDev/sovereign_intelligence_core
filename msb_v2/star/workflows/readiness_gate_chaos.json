{
  "id": "readiness-gate-chaos",
  "name": "Readiness Gate Chaos Injection",
  "schedule": "0 */6 * * *",
  "harness_action": {
    "type": "http",
    "method": "POST",
    "url": "http://127.0.0.1:8766/readiness-gate/chaos/inject",
    "body": {"scenario": "random"}
  },
  "retry_policy": {
    "max_retries": 1,
    "backoff_factor": 30
  },
  "failure_policy": {
    "on_failure": "alert",
    "alert_template": "readiness_gate_failure"
  },
  "active": true
}
