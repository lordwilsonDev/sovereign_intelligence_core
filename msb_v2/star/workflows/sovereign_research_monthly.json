{
  "id": "sovereign-research-monthly",
  "name": "Monthly Report Synthesis & Publication",
  "schedule": "0 10 1 * *",
  "harness_action": {
    "type": "http",
    "method": "POST",
    "url": "http://127.0.0.1:8766/research/assistant/run",
    "body": {"phase": "report_synthesis"}
  },
  "retry_policy": {
    "max_retries": 1,
    "backoff_factor": 300
  },
  "failure_policy": {
    "on_failure": "alert",
    "alert_template": "research_assistant_failure"
  },
  "active": true,
  "depends_on": ["sovereign-research-weekly"]
}
