{
  "id": "substrate-heartbeat",
  "name": "Null-Torsion Substrate Heartbeat",
  "cron": "*/1 * * * *",
  "schedule": "*/1 * * * *",
  "harness_action": {
    "type": "function",
    "module": "msb_v2.star.heartbeat",
    "function": "probe"
  },
  "retry_policy": {
    "max_retries": 1,
    "backoff_factor": 10
  },
  "failure_policy": {
    "on_failure": "alert",
    "alert_template": "substrate_heartbeat_failure"
  },
  "active": true
}
